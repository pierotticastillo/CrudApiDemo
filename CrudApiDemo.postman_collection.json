{
  "info": {
    "name": "CrudApiDemo - Productos API",
    "description": "Colección de endpoints para la API REST de gestión de productos.\n\nImportar en Postman, Bruno o cualquier cliente REST compatible.",
    "schema": "https://raw.githubusercontent.com/postmanlabs/postman-collection/main/schema/postman-collection-schema.json",
    "_exporter_id": "CrudApiDemo"
  },
  "item": [
    {
      "name": "Obtener todos los productos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"]
        },
        "description": "Obtiene la lista completa de productos."
      },
      "response": []
    },
    {
      "name": "Obtener producto por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "1"]
        },
        "description": "Obtiene un producto específico por su ID."
      },
      "response": []
    },
    {
      "name": "Crear un producto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Laptop Gamer\",\n  \"precio\": 1299.99,\n  \"stock\": 50\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"]
        },
        "description": "Crea un nuevo producto."
      },
      "response": []
    },
    {
      "name": "Actualizar un producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Laptop Gamer Actualizada\",\n  \"precio\": 1499.99,\n  \"stock\": 30\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "1"]
        },
        "description": "Actualiza un producto existente por su ID."
      },
      "response": []
    },
    {
      "name": "Eliminar un producto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "1"]
        },
        "description": "Elimina un producto por su ID."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5001",
      "type": "string"
    }
  ]
}
